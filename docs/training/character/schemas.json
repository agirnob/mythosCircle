{
  "wave1_response_format": {
    "type": "json_schema",
    "json_schema": {
      "name": "build_wave",
      "strict": true,
      "schema": {
        "type": "object",
        "required": [
          "entities",
          "edges"
        ],
        "properties": {
          "entities": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "object",
              "required": [
                "ref",
                "kind",
                "name"
              ],
              "properties": {
                "ref": {
                  "enum": [
                    "E0"
                  ]
                },
                "kind": {
                  "enum": [
                    "character",
                    "faction",
                    "place"
                  ]
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string"
                },
                "data": {
                  "type": "object"
                }
              },
              "additionalProperties": false
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "src",
                "dst",
                "type",
                "reason"
              ],
              "properties": {
                "src": {
                  "enum": [
                    "E0"
                  ]
                },
                "dst": {
                  "enum": [
                    "E0"
                  ]
                },
                "type": {
                  "enum": [
                    "ally_of",
                    "bases_at",
                    "controls",
                    "debt",
                    "employs",
                    "enemy_of",
                    "grudge",
                    "hails_from",
                    "kin_of",
                    "located_in",
                    "loyalty",
                    "member_of",
                    "part_of",
                    "protects",
                    "relationship",
                    "rival_of",
                    "worships"
                  ]
                },
                "counter": {
                  "type": "integer"
                },
                "reason": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
