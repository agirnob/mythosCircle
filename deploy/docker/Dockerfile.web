# mythosCircle web image — Vite build + nginx sidecar (Docker flow).
# Build from the repo root so the frontend/ context resolves:
#   docker build -f deploy/docker/Dockerfile.web .
# The frontend is same-origin (relative /api URLs), so the build takes
# no API-base build args — one image works for any hostname.
FROM node:22-slim AS build
WORKDIR /srv/frontend
COPY frontend/package.json frontend/package-lock.json frontend/.npmrc ./
RUN npm ci --silent
COPY frontend/ ./
RUN npm run build --silent

FROM nginx:alpine
COPY deploy/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /srv/frontend/dist /usr/share/nginx/html
EXPOSE 80
