# mythosCircle API image — FastAPI + uvicorn (Docker flow for Portainer).
# Build from the repo root so the backend/ context resolves:
#   docker build -f deploy/docker/Dockerfile.api .
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN pip install --no-cache-dir uv
WORKDIR /srv/backend
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --locked --no-dev
COPY backend/app ./app
# Workflow JSONs + prompt guides: code resolves them as
# <repo-root>/deploy/... (config.py / service.py parents[3]), which is
# /srv/deploy/... in this layout — no path env overrides needed.
COPY deploy/workflows /srv/deploy/workflows/
COPY deploy/guides /srv/deploy/guides/
# The shipped config: code resolves it as <repo-root>/deploy/config.toml,
# i.e. /srv/deploy/config.toml here, and it carries the tuned generation
# defaults (max_tokens, thinking). Without it those silently fall back to
# code defaults the operator cannot see. Precedence is unchanged —
# MYTHOSCIRCLE_* env from the stack still wins over this file.
COPY deploy/config.toml /srv/deploy/config.toml
EXPOSE 8000
# AD-3 single writer: run exactly one api replica (see compose).
# All state is env-driven (env > config > default); config.toml above
# carries the tuned defaults, and stack env overrides it.
CMD [".venv/bin/uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
